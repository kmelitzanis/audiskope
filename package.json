{
  "name": "audiskope",
  "version": "1.2.0",
  "description": "Cross-platform Audio Visualizer with Spectrogram Analysis",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "pnpm run build && electron .",
    "dev": "pnpm run build && electron . --enable-logging",
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.js",
    "build:app": "pnpm run build && pnpm run release:check && electron-builder --publish never",
    "build:mac": "pnpm run build && pnpm run release:check && electron-builder --mac --publish never",
    "build:win": "pnpm run build && pnpm run release:check && electron-builder --win --publish never",
    "build:linux": "pnpm run build && pnpm run release:check && electron-builder --linux --publish never",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:native": "node tests/native.cjs",
    "test:ui": "electron tests/ui.cjs",
    "licenses": "node scripts/generate-notices.cjs",
    "icons": "python3 scripts/generate-icons.py",
    "dmg-background": "python3 scripts/generate-dmg-background.py",
    "release:check": "node scripts/generate-notices.cjs --check-release",
    "test:release": "node --test tests/release.test.cjs",
    "build:audio": "bash scripts/build-audio.sh",
    "version:set": "node scripts/set-version.cjs"
  },
  "keywords": [
    "audio",
    "visualizer",
    "spectrogram",
    "electron",
    "fft",
    "typescript"
  ],
  "author": {
    "name": "Kostas Melitzanis",
    "email": "12257513+kmelitzanis@users.noreply.github.com"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^20.10.0",
    "electron": "^44.5.1",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.audiskope.app",
    "productName": "Audiskope",
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "!**/*.ts",
      "!**/*.map",
      "!**/*.md",
      "!.gitignore"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "third-party",
        "to": "licenses/third-party"
      },
      {
        "from": "assets/icons/desktop/png/512.png",
        "to": "icon.png"
      },
      {
        "from": "native/${platform}-${arch}",
        "to": "audio-tools",
        "filter": [
          "ffmpeg",
          "ffprobe",
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/desktop/icon.icns"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/icons/desktop/icon.icns",
      "background": "assets/dmg/background.png",
      "iconSize": 112,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 196,
          "type": "file"
        },
        {
          "x": 390,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/desktop/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "icon": "assets/icons/desktop/png"
    },
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "assets/icons/desktop"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kmelitzanis/audiskope.git"
  },
  "homepage": "https://github.com/kmelitzanis/audiskope#readme",
  "bugs": {
    "url": "https://github.com/kmelitzanis/audiskope/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
